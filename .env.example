# CLIMATESHELTER AI ENVIRONMENT CONFIGURATION
PROJECT_NAME="ClimateShelter AI"
VERSION="1.0.0"

# Environmental APIs (Open-Meteo free API - no key strictly required)
CLIMATE_API_KEY=""
CLIMATE_API_BASE_URL="https://api.open-meteo.com/v1"
SOIL_API_BASE_URL="https://soil-weights.open-meteo.com/v1"

# LLM Configuration
LLM_API_KEY=""
LLM_PROVIDER="gemini"

# ANSYS Integration Mode (mock, pymapdl, apdl_script)
ANSYS_MODE="mock"
ANSYS_EXECUTABLE_PATH="C:/Program Files/ANSYS Inc/v231/ansys/bin/winx64/ansys231.exe"

# Database & Frontend
DATABASE_URL="sqlite:///./climateshelter.db"
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
